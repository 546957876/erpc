# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS builder

ENV GOPROXY=https://goproxy.cn,direct \
    GOMAXPROCS=1 \
    GOFLAGS=-p=1

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/erpc ./cmd/erpc/main.go

WORKDIR /src/Admin
RUN go mod download
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/admin ./cmd/admin

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S erpc \
    && adduser -S -G erpc erpc \
    && mkdir -p /var/lib/erpc-admin/runtime \
    && chown -R erpc:erpc /var/lib/erpc-admin
COPY --from=builder /out/erpc /usr/local/bin/erpc
COPY --from=builder /out/admin /usr/local/bin/erpc-admin
COPY Admin/admin.docker.yaml /etc/erpc-admin/admin.yaml
USER erpc
EXPOSE 4000 8090
ENTRYPOINT ["/usr/local/bin/erpc-admin", "-config", "/etc/erpc-admin/admin.yaml"]
